        Scanner sc = new Scanner(System.in);

        System.out.print("Enter three numbers: ");
        int x = sc.nextInt();
        int y = sc.nextInt();
        int z = sc.nextInt();

        int max3 = (x > y) ? ((x > z) ? x : z) : ((y > z) ? y : z);

